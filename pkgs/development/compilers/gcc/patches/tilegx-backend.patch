+/* Implement cstore patterns.  */
+bool
+tilegx_emit_setcc (rtx operands[], machine_mode cmp_mode)
+{
+  return
+    tilegx_emit_setcc_internal (operands[0], GET_CODE (operands[1]),
+				operands[2], operands[3], cmp_mode);
+}
