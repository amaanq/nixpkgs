+
+/* Output assembler code to FILE to increment profiler label # LABELNO
+   for profiling a function entry.  */
+void
+tilegx_function_profiler (FILE *file, int labelno ATTRIBUTE_UNUSED)
+{
+  if (tilegx_in_bundle)
+    {
+      fprintf (file, "\t}\n");
+    }
+
+  if (cfun->static_chain_decl)
+    {
+      fprintf (file,
+	       "\t{\n"
+	       "\taddi\tsp, sp, -16\n"
+	       "\tst\tsp, r10\n"
+	       "\t}\n");
+    }
+
+  if (flag_pic)
+    {
+      fprintf (file,
+	       "\t{\n"
+	       "\tmove\tr10, lr\n"
+	       "\tjal\tplt(%s)\n"
+	       "\t}\n", MCOUNT_NAME);
+    }
+  else
+    {
+      fprintf (file,
+	       "\t{\n"
+	       "\tmove\tr10, lr\n"
+	       "\tjal\t%s\n"
+	       "\t}\n", MCOUNT_NAME);
+    }
+
+  if (cfun->static_chain_decl)
+    {
+      fprintf (file,
+	       "\taddi\tsp, sp, 16\n"
+	       "\tld\tr10, sp\n");
+    }
+
+  tilegx_in_bundle = false;
+}
