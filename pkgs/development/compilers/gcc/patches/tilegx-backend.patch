+/* Return a reference to the got to be used by tls references.  */
+static rtx
+tilegx_tls_got (void)
+{
+  rtx temp;
+  if (flag_pic)
+    {
+      crtl->uses_pic_offset_table = 1;
+      return tilegx_got_rtx ();
