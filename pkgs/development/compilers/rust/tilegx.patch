diff --git a/compiler/rustc_target/src/spec/targets/tilegx_unknown_linux_gnu.rs b/compiler/rustc_target/src/spec/targets/tilegx_unknown_linux_gnu.rs
new file mode 100644
index 0000000..c6dbf60
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/tilegx_unknown_linux_gnu.rs
@@ -0,0 +1,48 @@
+use rustc_abi::Endian;
+
+use crate::spec::{Arch, Cc, LinkerFlavor, Lld, RelocModel, Target, TargetMetadata, TargetOptions, base};
+
+pub(crate) fn target() -> Target {
+    let mut opts = TargetOptions {
+        endian: Endian::Little,
+        // The Tile backend registers no named CPUs; rustc's default
+        // target-cpu "generic" is rejected and makes the VLIW packetizer
+        // index an empty schedule model (SIGABRT). Empty CPU is llc's default
+        // and the only value the backend accepts.
+        cpu: "".into(),
+        // First bring-up is static-friendly: the LLVM backend defaults to
+        // Reloc::Static and its PIC path (GOT/PLT lowering) is not yet trusted.
+        relocation_model: RelocModel::Static,
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        // Static-only bring-up: the PIC/GOT path is untrusted, so there is no
+        // working dynamic-library flavor yet. Turning dynamic linking off makes
+        // the library build emit an rlib-only std instead of also producing a
+        // dylib, whose embedded-metadata object rustc cannot yet write for this
+        // architecture (the `object` crate has no TILE-Gx e_machine mapping).
+        dynamic_linking: false,
+        max_atomic_width: Some(64),
+        ..base::linux_gnu::opts()
+    };
+    // tilegx ld (bfd) does not re-scan archives, and rustc lists panic_unwind
+    // ahead of std, so std's __rust_start_panic/__rust_panic_cleanup references
+    // go unresolved. Wrap the archive inputs in a linker group so ld re-scans.
+    opts.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-Wl,--start-group"]);
+    opts.post_link_args
+        .entry(LinkerFlavor::Gnu(Cc::Yes, Lld::No))
+        .or_default()
+        .push("-Wl,--end-group".into());
+    Target {
+        llvm_target: "tilegx-unknown-linux-gnu".into(),
+        metadata: TargetMetadata {
+            description: Some("TILE-Gx Linux (glibc)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-i8:8:32-i16:16:32-i64:64-n32:64-S128".into(),
+        arch: Arch::Tilegx,
+        options: opts,
+    }
+}
