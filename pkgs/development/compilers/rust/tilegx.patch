diff --git a/compiler/rustc_target/src/callconv/tilegx.rs b/compiler/rustc_target/src/callconv/tilegx.rs
new file mode 100644
index 0000000..428e4c1
--- /dev/null
+++ b/compiler/rustc_target/src/callconv/tilegx.rs
@@ -0,0 +1,84 @@
+use rustc_abi::{BackendRepr, HasDataLayout, Primitive, Reg, Size, TyAbiInterface};
+
+use crate::callconv::{ArgAbi, ArgExtension, FnAbi, PassMode, Uniform};
+
+// The Tile-Gx C ABI passes the first arguments in the ten general registers
+// r0-r9 as 64-bit words, spilling the remainder to the stack. The core is
+// integer-only (no hardware FPU), so floats travel in the same general
+// registers and aggregates are decomposed into 64-bit integer chunks. This is
+// modelled on `mips64.rs` with the MIPS float-register special-casing removed.
+//
+// NOTE: this is a first-bring-up approximation. The exact aggregate-by-value
+// threshold, return-in-registers rules and varargs slot handling still need a
+// cross-check against the Tile-Gx psABI / the GCC tilegx backend so that
+// `extern "C"` matches gcc and glibc byte-for-byte.
+
+fn extend_integer_width<Ty>(arg: &mut ArgAbi<'_, Ty>, bits: u64) {
+    // 32-bit values are held sign-extended in a 64-bit register on Tile-Gx, so
+    // narrow scalars are promoted with sign extension regardless of signedness.
+    if let BackendRepr::Scalar(scalar) = arg.layout.backend_repr
+        && let Primitive::Int(i, signed) = scalar.primitive()
+        && !signed
+        && i.size().bits() == 32
+        && let PassMode::Direct(ref mut attrs) = arg.mode
+    {
+        attrs.ext(ArgExtension::Sext);
+        return;
+    }
+
+    arg.extend_integer_width_to(bits);
+}
+
+fn classify_ret<Ty>(ret: &mut ArgAbi<'_, Ty>, offset: &mut Size, dl_pointer_size: Size) {
+    if !ret.layout.is_aggregate() {
+        extend_integer_width(ret, 64);
+        return;
+    }
+
+    let size = ret.layout.size;
+    if size.bits() <= 128 {
+        ret.cast_to(Uniform::new(Reg::i64(), size));
+    } else {
+        ret.make_indirect();
+        *offset += dl_pointer_size;
+    }
+}
+
+fn classify_arg<'a, Ty, C>(cx: &C, arg: &mut ArgAbi<'a, Ty>, offset: &mut Size)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout,
+{
+    let dl = cx.data_layout();
+    let size = arg.layout.size;
+    let align = Ord::clamp(arg.layout.align.abi, dl.i64_align, dl.i128_align);
+
+    if !arg.layout.is_aggregate() {
+        extend_integer_width(arg, 64);
+    } else if arg.layout.pass_indirectly_in_non_rustic_abis(cx) {
+        arg.make_indirect();
+    } else {
+        arg.cast_to(Uniform::new(Reg::i64(), size));
+    }
+
+    *offset = offset.align_to(align) + size.align_to(align);
+}
+
+pub(crate) fn compute_abi_info<'a, Ty, C>(cx: &C, fn_abi: &mut FnAbi<'a, Ty>)
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout,
+{
+    let mut offset = Size::ZERO;
+
+    if !fn_abi.ret.is_ignore() && fn_abi.ret.layout.is_sized() {
+        classify_ret(&mut fn_abi.ret, &mut offset, cx.data_layout().pointer_size());
+    }
+
+    for arg in fn_abi.args.iter_mut() {
+        if arg.is_ignore() || !arg.layout.is_sized() {
+            continue;
+        }
+        classify_arg(cx, arg, &mut offset);
+    }
+}
