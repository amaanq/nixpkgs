+   <https://www.gnu.org/licenses/>.  */
+
+#ifndef _SYS_THREAD_POINTER_H
+#define _SYS_THREAD_POINTER_H
+
+static inline void *
+__thread_pointer (void)
+{
+  void *__result;
+  __asm__ ("move %0, tp" : "=r" (__result));
+  return __result;
+}
